# POLITEIA-V — configuration. Copy to .env (or .env.local) and fill in.

# ── Intelligence server (server/index.mjs) ─────────────────────────────────
# The Anthropic key stays SERVER-SIDE only — it is never bundled into the
# client. Without it the app runs in DEMO mode (simulated reasoning, clearly
# labelled). Get a key at https://platform.claude.com. The Counsellors run on
# Claude Opus 5; the weekly scan defaults to Opus 4.8 (see scripts/weekly-scan.mjs).
ANTHROPIC_API_KEY=

# Optional: API port (default 8785; the Vite proxy expects this).
# POLITEIA_V_API_PORT=8785

# ── Supabase auth (same pattern as base POLITEIA) ──────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Anti-spam (optional). Cloudflare Turnstile CAPTCHA blocks automated bot
# sign-ups; the SECRET key goes in Supabase → Authentication → Attack
# Protection → CAPTCHA. Leave unset to disable.
VITE_TURNSTILE_SITE_KEY=

# ── Δελφοί oracle (Diavgeia Watchdog) ──────────────────────────────────────
# The Δελφοί section iframes a SEPARATE Next.js app (it writes SQLite, so it
# can't be static — it needs its own Node host). For the LIVE site this MUST
# point at the deployed watchdog over HTTPS (e.g. Railway), or the section
# stays blank / falls back to localhost. Baked in at BUILD time (Vite inlines
# VITE_* vars), so set it before `npm run build`. Leave unset for local dev
# (defaults to http://localhost:3111/). No trailing path — just the origin.
VITE_DELPHI_URL=https://YOUR-WATCHDOG.up.railway.app

# ── YouTube transcripts (server/youtube.mjs) ─────────────────────────────────
# The public key of YouTube's own web player ("InnerTube"). Not a private secret, but kept
# out of the code so secret scanners do not flag it. Leave unset to disable transcripts.
YOUTUBE_INNERTUBE_KEY=
